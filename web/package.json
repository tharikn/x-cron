{
  "name": "x-cron-web",
  "version": "0.1.0",
  "description": "X Cron Jobs public Angular SSR site",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "build": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "test": "npm run test:unit",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/web/server/server.mjs",
    "sync:apk": "node scripts/sync-apk.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "30.1.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
