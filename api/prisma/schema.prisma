// X Cron Jobs — PostgreSQL data model (PRD §16)
// App objects live in dedicated schema `xcron` (not `public`).
// Apply on any environment: `npm run prisma:migrate` (= prisma migrate deploy).
// Local Step-1 runtime still uses in-memory stores unless JOBS_STORE=prisma.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["xcron"]
}

enum JobStatus {
  DRAFT
  NEEDS_REVIEW
  PUBLISHED
  EXPIRED
  REJECTED
  REMOVED

  @@schema("xcron")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  APPRENTICESHIP
  DAILY_WAGE

  @@schema("xcron")
}

enum PayPeriod {
  MONTHLY
  DAILY
  HOURLY

  @@schema("xcron")
}

enum UserStatus {
  GUEST
  ACTIVE
  DISABLED

  @@schema("xcron")
}

model User {
  id              String           @id @default(uuid())
  status          UserStatus       @default(ACTIVE)
  preferredLocale String           @default("en")
  displayName     String?
  /// Local username/password auth (unique, case-insensitive via lowercase storage).
  username        String?
  /// scrypt hash hex — never returned on public DTOs.
  passwordHash    String?
  /// scrypt salt hex — never returned on public DTOs.
  passwordSalt    String?
  phone           String?
  email           String?
  /// JSON array of roles: seeker | employer | admin
  rolesJson       Json             @default("[\"seeker\"]")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  identities      UserIdentity[]
  sessions        AuthSession[]
  preferences     UserPreference?
  entitlements    Entitlement[]
  payments        Payment[]
  ownedEmployers  Employer[]       @relation("EmployerOwner")
  memberships     EmployerMember[]
  auditEvents     AuditEvent[]
  savedJobs       SavedJob[]
  subscriptions   Subscription[]
  devices         DeviceRegistration[]
  notificationPrefs NotificationPreference?
  notifications   NotificationRecord[]
  notificationDeliveries NotificationDelivery[]
  seekerProfile   SeekerProfile?
  applications    SeekerApplication[]
  applyProfiles   ApplyProfile[]
  jobApplications JobApplication[]    @relation("JobApplicationSeeker")
  ownedJobApplications JobApplication[] @relation("JobApplicationOwner")
  applicationEvents ApplicationEvent[] @relation("ApplicationEventActor")
  applicationMessages ApplicationMessage[] @relation("ApplicationMessageSender")
  feedbackThreads FeedbackThread[] @relation("FeedbackThreadOwner")
  feedbackMessages FeedbackMessage[] @relation("FeedbackMessageSender")
  hiddenJobs      HiddenJob[]
  savedSearches   SavedSearch[]
  reputations     UserReputation[]
  reputationEvents ReputationEvent[]

  @@unique([username])
  @@index([email])
  @@index([phone])
  @@schema("xcron")
}

/// Performance Score per user × role (seeker | employer). Starts at 50.
model UserReputation {
  id        String   @id @default(uuid())
  userId    String
  /// seeker | employer
  role      String
  score     Int      @default(50)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([score])
  @@schema("xcron")
}

/// Ledger of Performance Score changes (apply fit, chat reply, review, etc.).
model ReputationEvent {
  id            String   @id @default(uuid())
  userId        String
  role          String
  type          String
  delta         Int
  scoreAfter    Int
  applicationId String?
  jobId         String?
  matchPercent  Int?
  note          String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, createdAt])
  @@index([type, createdAt])
  @@schema("xcron")
}

/// Long-lived refresh + short access pair. Survives API restart when AUTH_STORE=prisma.
model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  accessToken      String   @unique
  refreshToken     String   @unique
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  refreshExpiresAt DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshExpiresAt])
  @@schema("xcron")
}

model UserIdentity {
  id              String    @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@schema("xcron")
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  locationsJson   Json     @default("[]")
  radiusKm        Int?
  jobTypesJson    Json     @default("[]")
  salaryMinPaise  Int?
  salaryMaxPaise  Int?
  languagesJson   Json     @default("[\"en\",\"ta\"]")
  categoriesJson  Json     @default("[]")
  remotePreferred Boolean  @default(false)
  sort            String   @default("newest")
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

model Employer {
  id                 String           @id @default(uuid())
  name               String
  slug               String?
  about              String?
  logoUrl            String?
  verificationStatus String           @default("unverified")
  ownerUserId        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  owner              User             @relation("EmployerOwner", fields: [ownerUserId], references: [id])
  members            EmployerMember[]
  jobs               Job[]
  sources            JobSource[]
  importBatches      ImportBatch[]

  @@unique([slug])
  @@index([ownerUserId])
  @@schema("xcron")
}

model EmployerMember {
  id         String   @id @default(uuid())
  employerId String
  userId     String
  role       String   @default("staff")
  createdAt  DateTime @default(now())
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([employerId, userId])
  @@index([userId])
  @@schema("xcron")
}

model Job {
  id                   String            @id @default(uuid())
  employerId           String
  slug                 String            @unique
  status               JobStatus         @default(DRAFT)
  contentLanguage      String
  title                String
  category             String
  jobType              JobType
  country              String            @default("India")
  state                String
  district             String
  city                 String
  locality             String?
  remote               Boolean           @default(false)
  lat                  Float?
  lng                  Float?
  salaryMinPaise       Int?
  salaryMaxPaise       Int?
  salaryCurrency       String            @default("INR")
  salaryPeriod         PayPeriod?
  salaryNegotiable     Boolean           @default(false)
  experienceLabel      String?
  vacancies            Int?
  workSchedule         String?
  skillsJson           Json              @default("[]")
  about                String
  responsibilitiesJson Json              @default("[]")
  requirementsJson     Json              @default("[]")
  benefitsJson         Json              @default("[]")
  publishedAt          DateTime?
  effectiveFrom        DateTime?
  expiresAt            DateTime?
  walkInAt             DateTime?
  applyBy              DateTime?
  /// Optional anti-spam / intent question shown on apply (seeker must answer).
  screeningQuestion    String?
  priority             Int               @default(0)
  reportCount          Int               @default(0)
  moderationNote       String?
  ownerUserId          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  employer             Employer          @relation(fields: [employerId], references: [id])
  contactSecret        JobContactSecret?
  entitlements         Entitlement[]
  importRecords        ImportRecord[]
  savedBy              SavedJob[]
  applications         SeekerApplication[]
  jobApplications      JobApplication[]
  hiddenBy             HiddenJob[]
  viewEvents           JobViewEvent[]

  @@index([employerId])
  @@index([ownerUserId])
  @@index([status, publishedAt])
  @@index([city, district, state])
  @@index([jobType, category, contentLanguage])
  @@index([walkInAt])
  @@schema("xcron")
}

/// Listing view impression (once per viewerKey per UTC day) for recruiter analytics.
model JobViewEvent {
  id        String   @id @default(uuid())
  jobId     String
  viewerKey String
  /// UTC calendar day YYYY-MM-DD
  day       String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, viewerKey, day])
  @@index([jobId, day])
  @@schema("xcron")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@schema("xcron")
}

/// Seeker profile — personal / location / career (not a CV vault).
model SeekerProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  displayName         String?
  mobile              String?
  email               String?
  showContact         Boolean  @default(false)
  address             String?
  pincode             String?
  careerStage         String?
  educationStatus     String?
  openToInternship    Boolean?
  courseDetails       String?
  branchStudied       String?
  academicScore       String?
  experienceYears     Int?
  experienceMonths    Int?
  companyName         String?
  companyArea         String?
  currentSalary       String?
  expectedSalary      String?
  noticePeriod        String?
  experienceBand      String?
  skillsJson          Json     @default("[]")
  preferredCitiesJson Json     @default("[]")
  openToWork          Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

/// Multi-version apply profile (skills/projects/portfolio) — no CV/resume upload.
model ApplyProfile {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  headline           String?
  summary            String?
  experienceBand     String?
  skillsJson         Json     @default("[]")
  projectsJson       Json     @default("[]")
  portfolioLinksJson Json     @default("[]")
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@schema("xcron")
}

/// Contact-first I-reached-out marker (not ATS inbox).
model SeekerApplication {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  status    String   @default("contacted")
  channel   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@schema("xcron")
}

/// Formal ATS application (apply → offer letter timeline). No CV — apply profile snapshot.
model JobApplication {
  id                   String   @id @default(uuid())
  jobId                String
  employerId           String
  seekerUserId         String
  ownerUserId          String
  status               String   @default("applied")
  coverNote            String?
  /// Deprecated — unused; kept for older rows. Prefer applyProfileSnapshotJson.
  resumeUrl            String?
  applyProfileId       String?
  applyProfileSnapshotJson Json?
  seekerName           String?
  seekerPhone          String?
  seekerEmail          String?
  /// Answer to Job.screeningQuestion when the job requires one.
  screeningAnswer      String?
  /// Snapshot at apply time — employer “Likely spam” badge (not a hard block).
  likelySpam           Boolean  @default(false)
  spamReasonsJson      Json     @default("[]")
  offerLetterText      String?
  viewedAt             DateTime?
  /// Skills/experience fit % vs job at apply (Performance Score input).
  matchPercent         Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  job                  Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker               User     @relation("JobApplicationSeeker", fields: [seekerUserId], references: [id], onDelete: Cascade)
  owner                User     @relation("JobApplicationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  events               ApplicationEvent[]
  messages             ApplicationMessage[]

  @@unique([seekerUserId, jobId])
  @@index([jobId])
  @@index([employerId])
  @@index([ownerUserId])
  @@index([status])
  @@index([seekerUserId, createdAt])
  @@index([applyProfileId])
  @@index([likelySpam])
  @@schema("xcron")
}

/// In-app chat on a formal application (seeker ↔ recruiter).
model ApplicationMessage {
  id            String   @id @default(uuid())
  applicationId String
  senderUserId  String
  senderRole    String
  body          String
  createdAt     DateTime @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender        User     @relation("ApplicationMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([senderUserId])
  @@schema("xcron")
}

/// Contact Admin messenger thread (seeker/recruiter ↔ admin).
model FeedbackThread {
  id             String   @id @default(uuid())
  userId         String
  /// seeker | employer (recruiter UX)
  audience       String
  /// question | bug | suggestion | account | other
  category       String
  subject        String
  /// open | awaiting_admin | awaiting_user | closed
  status         String   @default("awaiting_admin")
  lastMessageAt  DateTime @default(now())
  lastSenderRole String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  closedAt       DateTime?
  user           User     @relation("FeedbackThreadOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages       FeedbackMessage[]

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([audience, status])
  @@schema("xcron")
}

model FeedbackMessage {
  id           String   @id @default(uuid())
  threadId     String
  senderUserId String
  /// seeker | employer | admin
  senderRole   String
  body         String
  createdAt    DateTime @default(now())
  thread       FeedbackThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User     @relation("FeedbackMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderUserId])
  @@schema("xcron")
}

/// Append-only Naukri-style timeline (ISO datetime with hour).
model ApplicationEvent {
  id            String   @id @default(uuid())
  applicationId String
  type          String
  fromStatus    String?
  toStatus      String?
  actorUserId   String?
  actorRole     String
  note          String?
  metaJson      Json?
  at            DateTime @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User?    @relation("ApplicationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, at])
  @@index([actorUserId])
  @@schema("xcron")
}

model HiddenJob {
  id         String   @id @default(uuid())
  userId     String
  jobId      String
  employerId String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([employerId])
  @@schema("xcron")
}

model SavedSearch {
  id           String   @id @default(uuid())
  userId       String
  name         String
  queryJson    Json     @default("{}")
  alertEnabled Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([alertEnabled])
  @@schema("xcron")
}

model Subscription {
  id             String   @id @default(uuid())
  userId         String
  planId         String
  status         String   @default("active")
  validFrom      DateTime @default(now())
  validUntil     DateTime
  gatewayOrderId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@schema("xcron")
}

model JobContactSecret {
  id             String   @id @default(uuid())
  jobId          String   @unique
  encryptedPhone String?
  encryptedEmail String?
  encryptedLinks String?
  keyVersion     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

model JobSource {
  id         String   @id @default(uuid())
  employerId String
  storageKey String
  sourceType String
  checksum   String?
  uploadedAt DateTime @default(now())
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@schema("xcron")
}

model ImportBatch {
  id               String         @id @default(uuid())
  employerId       String
  ownerUserId      String
  employerName     String         @default("")
  status           String         @default("queued")
  sourceType       String         @default("unknown")
  filename         String         @default("")
  totalRecords     Int            @default(0)
  processedRecords Int            @default(0)
  errorCount       Int            @default(0)
  warningsJson     Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  employer         Employer       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  records          ImportRecord[]

  @@index([employerId])
  @@index([ownerUserId])
  @@index([status])
  @@schema("xcron")
}

model ImportRecord {
  id             String      @id @default(uuid())
  batchId        String
  sourceLocator  String?
  extractionJson Json?
  confidence     Float?
  dedupeStatus   String      @default("pending")
  reviewStatus   String      @default("needs_review")
  jobId          String?
  error          String?
  createdAt      DateTime    @default(now())
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  job            Job?        @relation(fields: [jobId], references: [id])

  @@index([batchId])
  @@index([jobId])
  @@schema("xcron")
}

model Payment {
  id               String   @id @default(uuid())
  userId           String
  jobId            String?
  planId           String?
  product          String?
  gateway          String
  gatewayOrderId   String   @unique
  gatewayPaymentId String?
  amountPaise      Int
  currency         String   @default("INR")
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([jobId])
  @@index([status, createdAt])
  @@schema("xcron")
}

model Entitlement {
  id         String    @id @default(uuid())
  userId     String
  jobId      String?
  planId     String?
  paymentId  String?
  scope      String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  job        Job?      @relation(fields: [jobId], references: [id])

  @@index([userId, jobId, status])
  @@index([paymentId])
  @@schema("xcron")
}

/// Admin payment history timeline (richer than Payment rows). Runtime: PAYMENTS_STORE=prisma.
model PaymentHistory {
  id               String   @id @default(uuid())
  status           String
  reason           String?
  orderId          String?
  userId           String?
  actorId          String?
  jobId            String?
  planId           String?
  product          String?
  gateway          String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  amountPaise      Int?
  currency         String?
  ip               String?
  userAgent        String?
  metadataJson     Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([orderId])
  @@index([userId])
  @@schema("xcron")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@schema("xcron")
}

/// App / content language catalog (PRD multilingual). Runtime seeds mirror these rows.
model Language {
  code       String     @id
  name       String
  nativeName String
  enabled    Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  strings    UiString[]

  @@schema("xcron")
}

model UiString {
  id           String   @id @default(uuid())
  languageCode String
  key          String
  value        String
  updatedAt    DateTime @updatedAt
  language     Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([languageCode, key])
  @@index([languageCode])
  @@schema("xcron")
}

/// Public site chrome + commerce + auth TTLs. Runtime seeds mirror `footer` / `commerce` / `auth` keys.
model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@schema("xcron")
}

/// Push device tokens (FCM / stub). Live when NOTIFICATIONS_STORE=prisma (falls back to JOBS_STORE).
model DeviceRegistration {
  id         String   @id @default(uuid())
  userId     String?
  deviceId   String
  fcmToken   String
  platform   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([fcmToken])
  @@index([userId])
  @@index([deviceId])
  @@schema("xcron")
}

/// Per-user alert channel toggles (in-app / push / mail).
model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  jobAlertsEnabled    Boolean  @default(true)
  inAppEnabled        Boolean  @default(true)
  pushAlertsEnabled   Boolean  @default(true)
  emailAlertsEnabled  Boolean  @default(true)
  marketingEnabled    Boolean  @default(false)
  quietHoursStart     Int?
  quietHoursEnd       Int?
  dailyCap            Int      @default(20)
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

/// User-facing inbox rows + channel send records (in_app | push | mail).
model NotificationRecord {
  id                 String    @id @default(uuid())
  userId             String
  channel            String
  template           String
  title              String
  body               String
  dataJson           Json?
  status             String    @default("queued")
  dedupeKey          String
  jobId              String?
  dispatchId         String?
  provider           String?
  providerMessageId  String?
  error              String?
  readAt             DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatch           NotificationDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)

  @@unique([dedupeKey])
  @@index([userId, channel, createdAt])
  @@index([jobId])
  @@index([dispatchId])
  @@schema("xcron")
}

/// One fan-out trigger (e.g. job_published). History table for ops.
model NotificationDispatch {
  id               String    @id @default(uuid())
  triggerType      String
  jobId            String?
  status           String    @default("running")
  matchedCount     Int       @default(0)
  sentCount        Int       @default(0)
  suppressedCount  Int       @default(0)
  failedCount      Int       @default(0)
  skippedReason    String?
  metaJson         Json?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  notifications    NotificationRecord[]
  deliveries       NotificationDelivery[]

  @@index([triggerType, startedAt])
  @@index([jobId])
  @@index([status])
  @@schema("xcron")
}

/// Per user × channel attempt under a dispatch (audit / cost / debugging).
model NotificationDelivery {
  id                 String   @id @default(uuid())
  dispatchId         String
  userId             String
  channel            String
  status             String
  provider           String?
  providerMessageId  String?
  title              String
  body               String
  dedupeKey          String
  jobId              String?
  error              String?
  createdAt          DateTime @default(now())
  dispatch           NotificationDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dispatchId, createdAt])
  @@index([userId, createdAt])
  @@index([channel, status])
  @@schema("xcron")
}
