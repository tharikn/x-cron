// X Cron Jobs — PostgreSQL data model (PRD §16)
// App objects live in dedicated schema `xcron` (not `public`).
// Apply on any environment: `npm run prisma:migrate` (= prisma migrate deploy).
// Local Step-1 runtime still uses in-memory stores unless JOBS_STORE=prisma.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["xcron"]
}

enum JobStatus {
  DRAFT
  NEEDS_REVIEW
  PUBLISHED
  EXPIRED
  REJECTED
  REMOVED

  @@schema("xcron")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  APPRENTICESHIP
  DAILY_WAGE

  @@schema("xcron")
}

enum PayPeriod {
  MONTHLY
  DAILY
  HOURLY

  @@schema("xcron")
}

enum UserStatus {
  GUEST
  ACTIVE
  DISABLED

  @@schema("xcron")
}

model User {
  id              String           @id @default(uuid())
  status          UserStatus       @default(ACTIVE)
  preferredLocale String           @default("en")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  identities      UserIdentity[]
  preferences     UserPreference?
  entitlements    Entitlement[]
  payments        Payment[]
  ownedEmployers  Employer[]       @relation("EmployerOwner")
  memberships     EmployerMember[]
  auditEvents     AuditEvent[]
  savedJobs       SavedJob[]
  subscriptions   Subscription[]
  devices         DeviceRegistration[]
  notificationPrefs NotificationPreference?
  notifications   NotificationRecord[]
  notificationDeliveries NotificationDelivery[]

  @@schema("xcron")
}

model UserIdentity {
  id              String    @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@schema("xcron")
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  locationsJson   Json     @default("[]")
  radiusKm        Int?
  jobTypesJson    Json     @default("[]")
  salaryMinPaise  Int?
  salaryMaxPaise  Int?
  languagesJson   Json     @default("[\"en\",\"ta\"]")
  categoriesJson  Json     @default("[]")
  remotePreferred Boolean  @default(false)
  sort            String   @default("newest")
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

model Employer {
  id                 String           @id @default(uuid())
  name               String
  verificationStatus String           @default("unverified")
  ownerUserId        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  owner              User             @relation("EmployerOwner", fields: [ownerUserId], references: [id])
  members            EmployerMember[]
  jobs               Job[]
  sources            JobSource[]
  importBatches      ImportBatch[]

  @@index([ownerUserId])
  @@schema("xcron")
}

model EmployerMember {
  id         String   @id @default(uuid())
  employerId String
  userId     String
  role       String   @default("staff")
  createdAt  DateTime @default(now())
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([employerId, userId])
  @@index([userId])
  @@schema("xcron")
}

model Job {
  id                   String            @id @default(uuid())
  employerId           String
  slug                 String            @unique
  status               JobStatus         @default(DRAFT)
  contentLanguage      String
  title                String
  category             String
  jobType              JobType
  country              String            @default("India")
  state                String
  district             String
  city                 String
  locality             String?
  remote               Boolean           @default(false)
  salaryMinPaise       Int?
  salaryMaxPaise       Int?
  salaryCurrency       String            @default("INR")
  salaryPeriod         PayPeriod?
  salaryNegotiable     Boolean           @default(false)
  experienceLabel      String?
  vacancies            Int?
  workSchedule         String?
  skillsJson           Json              @default("[]")
  about                String
  responsibilitiesJson Json              @default("[]")
  requirementsJson     Json              @default("[]")
  benefitsJson         Json              @default("[]")
  publishedAt          DateTime?
  effectiveFrom        DateTime?
  expiresAt            DateTime?
  priority             Int               @default(0)
  reportCount          Int               @default(0)
  moderationNote       String?
  ownerUserId          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  employer             Employer          @relation(fields: [employerId], references: [id])
  contactSecret        JobContactSecret?
  entitlements         Entitlement[]
  importRecords        ImportRecord[]
  savedBy              SavedJob[]

  @@index([employerId])
  @@index([ownerUserId])
  @@index([status, publishedAt])
  @@index([city, district, state])
  @@index([jobType, category, contentLanguage])
  @@schema("xcron")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@schema("xcron")
}

model Subscription {
  id             String   @id @default(uuid())
  userId         String
  planId         String
  status         String   @default("active")
  validFrom      DateTime @default(now())
  validUntil     DateTime
  gatewayOrderId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@schema("xcron")
}

model JobContactSecret {
  id             String   @id @default(uuid())
  jobId          String   @unique
  encryptedPhone String?
  encryptedEmail String?
  encryptedLinks String?
  keyVersion     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

model JobSource {
  id         String   @id @default(uuid())
  employerId String
  storageKey String
  sourceType String
  checksum   String?
  uploadedAt DateTime @default(now())
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@schema("xcron")
}

model ImportBatch {
  id               String         @id @default(uuid())
  employerId       String
  ownerUserId      String
  employerName     String         @default("")
  status           String         @default("queued")
  sourceType       String         @default("unknown")
  filename         String         @default("")
  totalRecords     Int            @default(0)
  processedRecords Int            @default(0)
  errorCount       Int            @default(0)
  warningsJson     Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  employer         Employer       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  records          ImportRecord[]

  @@index([employerId])
  @@index([ownerUserId])
  @@index([status])
  @@schema("xcron")
}

model ImportRecord {
  id             String      @id @default(uuid())
  batchId        String
  sourceLocator  String?
  extractionJson Json?
  confidence     Float?
  dedupeStatus   String      @default("pending")
  reviewStatus   String      @default("needs_review")
  jobId          String?
  error          String?
  createdAt      DateTime    @default(now())
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  job            Job?        @relation(fields: [jobId], references: [id])

  @@index([batchId])
  @@index([jobId])
  @@schema("xcron")
}

model Payment {
  id               String   @id @default(uuid())
  userId           String
  jobId            String?
  planId           String?
  product          String?
  gateway          String
  gatewayOrderId   String   @unique
  gatewayPaymentId String?
  amountPaise      Int
  currency         String   @default("INR")
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([jobId])
  @@index([status, createdAt])
  @@schema("xcron")
}

model Entitlement {
  id         String    @id @default(uuid())
  userId     String
  jobId      String?
  planId     String?
  paymentId  String?
  scope      String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  job        Job?      @relation(fields: [jobId], references: [id])

  @@index([userId, jobId, status])
  @@index([paymentId])
  @@schema("xcron")
}

/// Admin payment history timeline (richer than Payment rows). Runtime: PAYMENTS_STORE=prisma.
model PaymentHistory {
  id               String   @id @default(uuid())
  status           String
  reason           String?
  orderId          String?
  userId           String?
  actorId          String?
  jobId            String?
  planId           String?
  product          String?
  gateway          String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  amountPaise      Int?
  currency         String?
  ip               String?
  userAgent        String?
  metadataJson     Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([orderId])
  @@index([userId])
  @@schema("xcron")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@schema("xcron")
}

/// App / content language catalog (PRD multilingual). Runtime seeds mirror these rows.
model Language {
  code       String     @id
  name       String
  nativeName String
  enabled    Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  strings    UiString[]

  @@schema("xcron")
}

model UiString {
  id           String   @id @default(uuid())
  languageCode String
  key          String
  value        String
  updatedAt    DateTime @updatedAt
  language     Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([languageCode, key])
  @@index([languageCode])
  @@schema("xcron")
}

/// Public site chrome + commerce + auth TTLs. Runtime seeds mirror `footer` / `commerce` / `auth` keys.
model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@schema("xcron")
}

/// Push device tokens (FCM / stub). Live when NOTIFICATIONS_STORE=prisma (falls back to JOBS_STORE).
model DeviceRegistration {
  id         String   @id @default(uuid())
  userId     String?
  deviceId   String
  fcmToken   String
  platform   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([fcmToken])
  @@index([userId])
  @@index([deviceId])
  @@schema("xcron")
}

/// Per-user alert channel toggles (in-app / push / mail).
model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  jobAlertsEnabled    Boolean  @default(true)
  inAppEnabled        Boolean  @default(true)
  pushAlertsEnabled   Boolean  @default(true)
  emailAlertsEnabled  Boolean  @default(true)
  marketingEnabled    Boolean  @default(false)
  quietHoursStart     Int?
  quietHoursEnd       Int?
  dailyCap            Int      @default(20)
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

/// User-facing inbox rows + channel send records (in_app | push | mail).
model NotificationRecord {
  id                 String    @id @default(uuid())
  userId             String
  channel            String
  template           String
  title              String
  body               String
  dataJson           Json?
  status             String    @default("queued")
  dedupeKey          String
  jobId              String?
  dispatchId         String?
  provider           String?
  providerMessageId  String?
  error              String?
  readAt             DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatch           NotificationDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)

  @@unique([dedupeKey])
  @@index([userId, channel, createdAt])
  @@index([jobId])
  @@index([dispatchId])
  @@schema("xcron")
}

/// One fan-out trigger (e.g. job_published). History table for ops.
model NotificationDispatch {
  id               String    @id @default(uuid())
  triggerType      String
  jobId            String?
  status           String    @default("running")
  matchedCount     Int       @default(0)
  sentCount        Int       @default(0)
  suppressedCount  Int       @default(0)
  failedCount      Int       @default(0)
  skippedReason    String?
  metaJson         Json?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  notifications    NotificationRecord[]
  deliveries       NotificationDelivery[]

  @@index([triggerType, startedAt])
  @@index([jobId])
  @@index([status])
  @@schema("xcron")
}

/// Per user × channel attempt under a dispatch (audit / cost / debugging).
model NotificationDelivery {
  id                 String   @id @default(uuid())
  dispatchId         String
  userId             String
  channel            String
  status             String
  provider           String?
  providerMessageId  String?
  title              String
  body               String
  dedupeKey          String
  jobId              String?
  error              String?
  createdAt          DateTime @default(now())
  dispatch           NotificationDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dispatchId, createdAt])
  @@index([userId, createdAt])
  @@index([channel, status])
  @@schema("xcron")
}
