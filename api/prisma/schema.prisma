// X Cron Jobs — PostgreSQL data model (PRD §16)
// App objects live in dedicated schema `xcron` (not `public`).
// Apply on any environment: `npm run prisma:migrate` (= prisma migrate deploy).
// Local Step-1 runtime still uses in-memory stores unless JOBS_STORE=prisma.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["xcron"]
}

enum JobStatus {
  DRAFT
  NEEDS_REVIEW
  PUBLISHED
  EXPIRED
  REJECTED
  REMOVED

  @@schema("xcron")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  APPRENTICESHIP
  DAILY_WAGE

  @@schema("xcron")
}

enum PayPeriod {
  MONTHLY
  DAILY
  HOURLY

  @@schema("xcron")
}

enum UserStatus {
  GUEST
  ACTIVE
  DISABLED

  @@schema("xcron")
}

model User {
  id              String           @id @default(uuid())
  status          UserStatus       @default(ACTIVE)
  preferredLocale String           @default("en")
  displayName     String?
  /// Local username/password auth (unique, case-insensitive via lowercase storage).
  username        String?
  /// scrypt hash hex — never returned on public DTOs.
  passwordHash    String?
  /// scrypt salt hex — never returned on public DTOs.
  passwordSalt    String?
  phone           String?
  email           String?
  /// JSON array of roles: seeker | employer | admin | moderator
  rolesJson       Json             @default("[\"seeker\"]")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  identities      UserIdentity[]
  sessions        AuthSession[]
  preferences     UserPreference?
  entitlements    Entitlement[]
  payments        Payment[]
  ownedEmployers  Employer[]       @relation("EmployerOwner")
  memberships     EmployerMember[]
  auditEvents     AuditEvent[]
  trustAuditEvents TrustAuditEvent[]
  accountSuspensions AccountSuspension[]
  moderationCasesAssigned ModerationCase[] @relation("ModerationCaseAssignee")
  moderationReports ModerationReport[]
  savedJobs       SavedJob[]
  subscriptions   Subscription[]
  devices         DeviceRegistration[]
  notificationPrefs NotificationPreference?
  notifications   NotificationRecord[]
  notificationDeliveries NotificationDelivery[]
  seekerProfile   SeekerProfile?
  applications    SeekerApplication[]
  applyProfiles   ApplyProfile[]
  jobApplications JobApplication[]    @relation("JobApplicationSeeker")
  ownedJobApplications JobApplication[] @relation("JobApplicationOwner")
  applicationEvents ApplicationEvent[] @relation("ApplicationEventActor")
  applicationMessages ApplicationMessage[] @relation("ApplicationMessageSender")
  feedbackThreads FeedbackThread[] @relation("FeedbackThreadOwner")
  feedbackMessages FeedbackMessage[] @relation("FeedbackMessageSender")
  hiddenJobs      HiddenJob[]
  savedSearches   SavedSearch[]
  reputations     UserReputation[]
  reputationEvents ReputationEvent[]
  trackingEvents  TrackingEvent[]
  storedFiles     StoredFile[]

  @@unique([username])
  @@index([email])
  @@index([phone])
  @@schema("xcron")
}

/// Performance Score per user × role (seeker | employer). Starts at 50.
model UserReputation {
  id        String   @id @default(uuid())
  userId    String
  /// seeker | employer
  role      String
  score     Int      @default(50)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([score])
  @@schema("xcron")
}

/// Ledger of Performance Score changes (apply fit, chat reply, review, etc.).
model ReputationEvent {
  id            String   @id @default(uuid())
  userId        String
  role          String
  type          String
  delta         Int
  scoreAfter    Int
  applicationId String?
  jobId         String?
  matchPercent  Int?
  note          String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, createdAt])
  @@index([type, createdAt])
  @@schema("xcron")
}

/// Long-lived refresh + short access pair. Survives API restart when AUTH_STORE=prisma.
model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  accessToken      String   @unique
  refreshToken     String   @unique
  /// Refresh-token family — reuse of a rotated refresh revokes the whole family.
  familyId         String
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  refreshExpiresAt DateTime
  /// Client IP at issue / last refresh (admin tracking).
  ip               String?
  userAgent        String?
  lastSeenAt       DateTime?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([refreshExpiresAt])
  @@schema("xcron")
}

/// Product analytics events (access, search, share, apply, heartbeat, page_view).
model TrackingEvent {
  id         String   @id @default(uuid())
  type       String
  userId     String?
  visitorKey String?
  jobId      String?
  path       String?
  ip         String?
  userAgent  String?
  durationMs Int?
  metaJson   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([visitorKey, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@schema("xcron")
}

/// Retired refresh tokens kept until expiry so reuse can revoke the family.
model RevokedRefreshToken {
  refreshToken String   @id
  userId       String
  familyId     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([familyId])
  @@index([expiresAt])
  @@schema("xcron")
}

model UserIdentity {
  id              String    @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@schema("xcron")
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  locationsJson   Json     @default("[]")
  radiusKm        Int?
  jobTypesJson    Json     @default("[]")
  salaryMinPaise  Int?
  salaryMaxPaise  Int?
  languagesJson   Json     @default("[\"en\",\"ta\"]")
  categoriesJson  Json     @default("[]")
  remotePreferred Boolean  @default(false)
  sort            String   @default("newest")
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

/// Company workspace (API surface `/v1/companies`; legacy clients still say “employer”).
model Employer {
  id                    String                     @id @default(uuid())
  name                  String
  /// Legal / registered name when distinct from display `name`.
  legalName             String?
  slug                  String?
  about                 String?
  logoUrl               String?
  website               String?
  /// Verified or claimed email domain (e.g. acme.com) — lowercase.
  verifiedEmailDomain   String?
  industry              String?
  /// Company size band, e.g. "1-10" | "11-50" | "51-200" | "201-1000" | "1000+".
  sizeBand              String?
  headquarters          String?
  /// JSON string array of hiring location labels.
  hiringLocationsJson   String                     @default("[]")
  /// unverified | pending | verified | rejected | suspended | reverify_required
  verificationStatus    String                     @default("unverified")
  verificationNotes     String?
  /// Internal-only trust tier: standard | elevated | restricted
  trustTier             String                     @default("standard")
  /// JSON string array of internal risk flags.
  riskFlagsJson         String                     @default("[]")
  /// JSON workspace settings (notify prefs, pipeline defaults).
  workspaceSettingsJson String                     @default("{}")
  ownerUserId           String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  owner                 User                       @relation("EmployerOwner", fields: [ownerUserId], references: [id])
  members               EmployerMember[]
  invitations           EmployerInvitation[]
  verificationEvidence  EmployerVerificationEvidence[]
  verificationAudits    EmployerVerificationAudit[]
  internalNotes         CompanyInternalNote[]
  interviews            CompanyInterview[]
  jobs                  Job[]
  sources               JobSource[]
  importBatches         ImportBatch[]

  @@unique([slug])
  @@index([ownerUserId])
  @@schema("xcron")
}

model EmployerMember {
  id              String    @id @default(uuid())
  employerId      String
  userId          String
  /// owner | admin | recruiter | hiring_manager | viewer
  role            String    @default("recruiter")
  /// invited | active | revoked
  status          String    @default("active")
  invitedByUserId String?
  joinedAt        DateTime?
  revokedAt       DateTime?
  /// JSON saved applicant-pipeline filters for this member.
  savedFiltersJson String   @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  employer        Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([employerId, userId])
  @@index([userId])
  @@index([employerId, status])
  @@schema("xcron")
}

model EmployerInvitation {
  id              String    @id @default(uuid())
  employerId      String
  email           String
  /// admin | recruiter | hiring_manager | viewer (never owner via invite)
  role            String    @default("recruiter")
  token           String    @unique
  invitedByUserId String
  status          String    @default("pending")
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  employer        Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, status])
  @@index([email])
  @@schema("xcron")
}

model EmployerVerificationEvidence {
  id           String   @id @default(uuid())
  employerId   String
  /// domain_email | business_registration | website | other
  kind         String
  label        String
  /// Private reference (URL or storage key) — never public on job DTOs.
  reference    String
  submittedBy  String
  createdAt    DateTime @default(now())
  employer     Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@schema("xcron")
}

model EmployerVerificationAudit {
  id         String   @id @default(uuid())
  employerId String
  actorUserId String
  action     String
  detail     String   @default("")
  createdAt  DateTime @default(now())
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, createdAt])
  @@schema("xcron")
}

/// Notes visible only to authorised company members (not seekers).
model CompanyInternalNote {
  id            String   @id @default(uuid())
  employerId    String
  applicationId String?
  body          String
  authorUserId  String
  createdAt     DateTime @default(now())
  employer      Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, applicationId])
  @@schema("xcron")
}

model CompanyInterview {
  id            String   @id @default(uuid())
  employerId    String
  applicationId String
  scheduledAt   String
  mode          String   @default("video")
  locationOrLink String  @default("")
  notes         String   @default("")
  status        String   @default("scheduled")
  createdByUserId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employer      Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, applicationId])
  @@index([scheduledAt])
  @@schema("xcron")
}

model Job {
  id                   String            @id @default(uuid())
  employerId           String
  slug                 String            @unique
  status               JobStatus         @default(DRAFT)
  contentLanguage      String
  title                String
  category             String
  jobType              JobType
  country              String            @default("India")
  state                String
  district             String
  city                 String
  locality             String?
  remote               Boolean           @default(false)
  lat                  Float?
  lng                  Float?
  salaryMinPaise       Int?
  salaryMaxPaise       Int?
  salaryCurrency       String            @default("INR")
  salaryPeriod         PayPeriod?
  salaryNegotiable     Boolean           @default(false)
  experienceLabel      String?
  vacancies            Int?
  workSchedule         String?
  skillsJson           Json              @default("[]")
  about                String
  responsibilitiesJson Json              @default("[]")
  requirementsJson     Json              @default("[]")
  benefitsJson         Json              @default("[]")
  publishedAt          DateTime?
  effectiveFrom        DateTime?
  expiresAt            DateTime?
  walkInAt             DateTime?
  applyBy              DateTime?
  /// Optional anti-spam / intent question shown on apply (seeker must answer).
  screeningQuestion    String?
  priority             Int               @default(0)
  reportCount          Int               @default(0)
  moderationNote       String?
  ownerUserId          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  employer             Employer          @relation(fields: [employerId], references: [id])
  contactSecret        JobContactSecret?
  entitlements         Entitlement[]
  importRecords        ImportRecord[]
  savedBy              SavedJob[]
  applications         SeekerApplication[]
  jobApplications      JobApplication[]
  hiddenBy             HiddenJob[]
  viewEvents           JobViewEvent[]

  @@index([employerId])
  @@index([ownerUserId])
  @@index([status, publishedAt])
  @@index([city, district, state])
  @@index([jobType, category, contentLanguage])
  @@index([walkInAt])
  @@schema("xcron")
}

/// Listing view impression (once per viewerKey per UTC day) for recruiter analytics.
model JobViewEvent {
  id        String   @id @default(uuid())
  jobId     String
  viewerKey String
  /// UTC calendar day YYYY-MM-DD
  day       String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, viewerKey, day])
  @@index([jobId, day])
  @@schema("xcron")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@schema("xcron")
}

/// Seeker profile — personal / location / career (not a CV vault).
model SeekerProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  displayName         String?
  mobile              String?
  email               String?
  showContact         Boolean  @default(false)
  address             String?
  pincode             String?
  careerStage         String?
  educationStatus     String?
  openToInternship    Boolean?
  courseDetails       String?
  branchStudied       String?
  academicScore       String?
  experienceYears     Int?
  experienceMonths    Int?
  companyName         String?
  companyArea         String?
  currentSalary       String?
  expectedSalary      String?
  noticePeriod        String?
  experienceBand      String?
  skillsJson          Json     @default("[]")
  preferredCitiesJson Json     @default("[]")
  openToWork          Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

/// Multi-version apply profile (skills/projects/portfolio) — no CV/resume upload.
model ApplyProfile {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  headline           String?
  summary            String?
  experienceBand     String?
  skillsJson         Json     @default("[]")
  projectsJson       Json     @default("[]")
  portfolioLinksJson Json     @default("[]")
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@schema("xcron")
}

/// Contact-first I-reached-out marker (not ATS inbox).
model SeekerApplication {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  status    String   @default("contacted")
  channel   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@schema("xcron")
}

/// Formal ATS application (apply → offer letter timeline). No CV — apply profile snapshot.
model JobApplication {
  id                   String   @id @default(uuid())
  jobId                String
  employerId           String
  seekerUserId         String
  ownerUserId          String
  status               String   @default("applied")
  coverNote            String?
  /// Deprecated — unused; kept for older rows. Prefer applyProfileSnapshotJson.
  resumeUrl            String?
  applyProfileId       String?
  applyProfileSnapshotJson Json?
  seekerName           String?
  seekerPhone          String?
  seekerEmail          String?
  /// Answer to Job.screeningQuestion when the job requires one.
  screeningAnswer      String?
  /// Snapshot at apply time — employer “Likely spam” badge (not a hard block).
  likelySpam           Boolean  @default(false)
  spamReasonsJson      Json     @default("[]")
  offerLetterText      String?
  viewedAt             DateTime?
  /// Skills/experience fit % vs job at apply (Performance Score input).
  matchPercent         Int?
  /// Last time seeker opened chat / marked conversation read.
  seekerLastReadAt     DateTime?
  /// Last time employer opened chat / marked conversation read.
  employerLastReadAt   DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  job                  Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker               User     @relation("JobApplicationSeeker", fields: [seekerUserId], references: [id], onDelete: Cascade)
  owner                User     @relation("JobApplicationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  events               ApplicationEvent[]
  messages             ApplicationMessage[]

  @@unique([seekerUserId, jobId])
  @@index([jobId])
  @@index([employerId])
  @@index([ownerUserId])
  @@index([status])
  @@index([seekerUserId, createdAt])
  @@index([applyProfileId])
  @@index([likelySpam])
  @@schema("xcron")
}

/// In-app chat on a formal application (seeker ↔ recruiter).
model ApplicationMessage {
  id            String   @id @default(uuid())
  applicationId String
  senderUserId  String
  senderRole    String
  body          String
  createdAt     DateTime @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender        User     @relation("ApplicationMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([senderUserId])
  @@schema("xcron")
}

/// Contact Admin messenger thread (seeker/recruiter ↔ admin).
model FeedbackThread {
  id             String   @id @default(uuid())
  userId         String
  /// seeker | employer (recruiter UX)
  audience       String
  /// question | bug | suggestion | account | other
  category       String
  subject        String
  /// open | awaiting_admin | awaiting_user | closed
  status         String   @default("awaiting_admin")
  lastMessageAt  DateTime @default(now())
  lastSenderRole String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  closedAt       DateTime?
  user           User     @relation("FeedbackThreadOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages       FeedbackMessage[]

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([audience, status])
  @@schema("xcron")
}

model FeedbackMessage {
  id           String   @id @default(uuid())
  threadId     String
  senderUserId String
  /// seeker | employer | admin
  senderRole   String
  body         String
  createdAt    DateTime @default(now())
  thread       FeedbackThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User     @relation("FeedbackMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderUserId])
  @@schema("xcron")
}

/// Append-only Naukri-style timeline (ISO datetime with hour).
model ApplicationEvent {
  id            String   @id @default(uuid())
  applicationId String
  type          String
  fromStatus    String?
  toStatus      String?
  actorUserId   String?
  actorRole     String
  note          String?
  metaJson      Json?
  at            DateTime @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User?    @relation("ApplicationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, at])
  @@index([actorUserId])
  @@schema("xcron")
}

model HiddenJob {
  id         String   @id @default(uuid())
  userId     String
  jobId      String
  employerId String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([employerId])
  @@schema("xcron")
}

model SavedSearch {
  id           String   @id @default(uuid())
  userId       String
  name         String
  queryJson    Json     @default("{}")
  alertEnabled Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([alertEnabled])
  @@schema("xcron")
}

model Subscription {
  id             String   @id @default(uuid())
  userId         String
  planId         String
  status         String   @default("active")
  validFrom      DateTime @default(now())
  validUntil     DateTime
  gatewayOrderId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@schema("xcron")
}

model JobContactSecret {
  id             String   @id @default(uuid())
  jobId          String   @unique
  encryptedPhone String?
  encryptedEmail String?
  encryptedLinks String?
  keyVersion     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

model JobSource {
  id         String   @id @default(uuid())
  employerId String
  storageKey String
  sourceType String
  checksum   String?
  uploadedAt DateTime @default(now())
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@schema("xcron")
}

model ImportBatch {
  id               String         @id @default(uuid())
  employerId       String
  ownerUserId      String
  employerName     String         @default("")
  status           String         @default("queued")
  sourceType       String         @default("unknown")
  filename         String         @default("")
  totalRecords     Int            @default(0)
  processedRecords Int            @default(0)
  errorCount       Int            @default(0)
  warningsJson     Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  employer         Employer       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  records          ImportRecord[]

  @@index([employerId])
  @@index([ownerUserId])
  @@index([status])
  @@schema("xcron")
}

model ImportRecord {
  id             String      @id @default(uuid())
  batchId        String
  sourceLocator  String?
  extractionJson Json?
  confidence     Float?
  dedupeStatus   String      @default("pending")
  reviewStatus   String      @default("needs_review")
  jobId          String?
  error          String?
  createdAt      DateTime    @default(now())
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  job            Job?        @relation(fields: [jobId], references: [id])

  @@index([batchId])
  @@index([jobId])
  @@schema("xcron")
}

model Payment {
  id               String   @id @default(uuid())
  userId           String
  jobId            String?
  planId           String?
  product          String?
  gateway          String
  gatewayOrderId   String   @unique
  gatewayPaymentId String?
  amountPaise      Int
  currency         String   @default("INR")
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([jobId])
  @@index([status, createdAt])
  @@schema("xcron")
}

model Entitlement {
  id         String    @id @default(uuid())
  userId     String
  jobId      String?
  planId     String?
  paymentId  String?
  scope      String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  job        Job?      @relation(fields: [jobId], references: [id])

  @@index([userId, jobId, status])
  @@index([paymentId])
  @@schema("xcron")
}

/// Admin payment history timeline (richer than Payment rows). Runtime: PAYMENTS_STORE=prisma.
model PaymentHistory {
  id               String   @id @default(uuid())
  status           String
  reason           String?
  orderId          String?
  userId           String?
  actorId          String?
  jobId            String?
  planId           String?
  product          String?
  gateway          String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  amountPaise      Int?
  currency         String?
  ip               String?
  userAgent        String?
  metadataJson     Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([orderId])
  @@index([userId])
  @@schema("xcron")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@schema("xcron")
}

/// App / content language catalog (PRD multilingual). Runtime seeds mirror these rows.
model Language {
  code       String     @id
  name       String
  nativeName String
  enabled    Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  strings    UiString[]

  @@schema("xcron")
}

model UiString {
  id           String   @id @default(uuid())
  languageCode String
  key          String
  value        String
  updatedAt    DateTime @updatedAt
  language     Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([languageCode, key])
  @@index([languageCode])
  @@schema("xcron")
}

/// Public site chrome + commerce + auth TTLs. Runtime seeds mirror `footer` / `commerce` / `auth` keys.
model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@schema("xcron")
}

/// Push device tokens (FCM / stub). Live when NOTIFICATIONS_STORE=prisma (falls back to JOBS_STORE).
model DeviceRegistration {
  id         String   @id @default(uuid())
  userId     String?
  deviceId   String
  fcmToken   String
  platform   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([fcmToken])
  @@index([userId])
  @@index([deviceId])
  @@schema("xcron")
}

/// Per-user alert channel toggles (in-app / push / mail).
model NotificationPreference {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  jobAlertsEnabled             Boolean  @default(true)
  applicationUpdatesEnabled    Boolean  @default(true)
  recruiterMessagesEnabled     Boolean  @default(true)
  productAnnouncementsEnabled  Boolean  @default(false)
  inAppEnabled                 Boolean  @default(true)
  pushAlertsEnabled            Boolean  @default(true)
  emailAlertsEnabled           Boolean  @default(true)
  marketingEnabled             Boolean  @default(false)
  quietHoursStart              Int?
  quietHoursEnd                Int?
  dailyCap                     Int      @default(20)
  updatedAt                    DateTime @updatedAt
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("xcron")
}

/// User-facing inbox rows + channel send records (in_app | push | mail).
model NotificationRecord {
  id                 String    @id @default(uuid())
  userId             String
  channel            String
  template           String
  title              String
  body               String
  dataJson           Json?
  status             String    @default("queued")
  dedupeKey          String
  jobId              String?
  dispatchId         String?
  provider           String?
  providerMessageId  String?
  error              String?
  readAt             DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatch           NotificationDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)

  @@unique([dedupeKey])
  @@index([userId, channel, createdAt])
  @@index([jobId])
  @@index([dispatchId])
  @@schema("xcron")
}

/// One fan-out trigger (e.g. job_published). History table for ops.
model NotificationDispatch {
  id               String    @id @default(uuid())
  triggerType      String
  jobId            String?
  status           String    @default("running")
  matchedCount     Int       @default(0)
  sentCount        Int       @default(0)
  suppressedCount  Int       @default(0)
  failedCount      Int       @default(0)
  skippedReason    String?
  metaJson         Json?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  notifications    NotificationRecord[]
  deliveries       NotificationDelivery[]

  @@index([triggerType, startedAt])
  @@index([jobId])
  @@index([status])
  @@schema("xcron")
}

/// Per user × channel attempt under a dispatch (audit / cost / debugging).
model NotificationDelivery {
  id                 String   @id @default(uuid())
  dispatchId         String
  userId             String
  channel            String
  status             String
  provider           String?
  providerMessageId  String?
  title              String
  body               String
  dedupeKey          String
  jobId              String?
  error              String?
  createdAt          DateTime @default(now())
  dispatch           NotificationDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dispatchId, createdAt])
  @@index([userId, createdAt])
  @@index([channel, status])
  @@schema("xcron")
}

/// Trust desk moderation case (queues: verification, job review, reports, dupes, suspicious, appeal).
model ModerationCase {
  id                 String   @id @default(uuid())
  queue              String
  status             String   @default("open")
  priority           String   @default("normal")
  targetType         String
  targetId           String
  category           String?
  details            String?
  evidenceJson       Json     @default("{}")
  riskFlagsJson      Json     @default("[]")
  riskScore          Int      @default(0)
  dismissedRiskFlagsJson Json @default("[]")
  assigneeUserId     String?
  slaAt              DateTime?
  decision           String?
  reasonCode         String?
  reason             String?
  decidedByUserId    String?
  decidedAt          DateTime?
  relatedCaseId      String?
  feedbackThreadId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  assignee           User?    @relation("ModerationCaseAssignee", fields: [assigneeUserId], references: [id])
  reports            ModerationReport[]

  @@index([queue, status, updatedAt])
  @@index([targetType, targetId, status])
  @@index([assigneeUserId, status])
  @@schema("xcron")
}

model ModerationReport {
  id             String   @id @default(uuid())
  caseId         String
  targetType     String
  targetId       String
  category       String
  details        String   @default("")
  reporterUserId String?
  createdAt      DateTime @default(now())
  case           ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporter       User?    @relation(fields: [reporterUserId], references: [id])

  @@index([caseId, createdAt])
  @@index([targetType, targetId])
  @@index([reporterUserId])
  @@schema("xcron")
}

/// Append-only trust/moderation audit (separate from payment AuditEvent).
model TrustAuditEvent {
  id             String   @id @default(uuid())
  actorId        String?
  action         String
  resourceType   String
  resourceId     String
  reason         String?
  reasonCode     String?
  correlationId  String?
  beforeJson     Json?
  afterJson      Json?
  createdAt      DateTime @default(now())
  actor          User?    @relation(fields: [actorId], references: [id])

  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@schema("xcron")
}

model AccountSuspension {
  id               String    @id @default(uuid())
  userId           String
  reasonCode       String
  reason           String
  startsAt         DateTime
  endsAt           DateTime?
  actorId          String
  active           Boolean   @default(true)
  clearedAt        DateTime?
  clearedByUserId  String?
  clearReason      String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([active, endsAt])
  @@schema("xcron")
}

/// Singleton-ish moderation config (key = "default").
model ModerationConfigRow {
  id        String   @id @default("default")
  configJson Json
  updatedAt DateTime @updatedAt

  @@schema("xcron")
}

/// Durable async side-effect log (transactional outbox). Relay → BullMQ / inline.
model OutboxEvent {
  id          String    @id @default(uuid())
  topic       String
  payloadJson Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([status, availableAt])
  @@index([topic, createdAt])
  @@schema("xcron")
}

/// Uploaded blob metadata (bytes live in object storage / local disk).
model StoredFile {
  id           String   @id @default(uuid())
  ownerUserId  String
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  backend      String
  createdAt    DateTime @default(now())
  owner        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@schema("xcron")
}
