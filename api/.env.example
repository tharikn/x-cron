PORT=3000
NODE_ENV=development
# Jobs + bulk import persistence. Use `prisma` with Postgres; `memory` resets on restart.
JOBS_STORE=prisma
# JOBS_STORE=memory
# Notifications / payments / auth stores. If unset, follow JOBS_STORE.
NOTIFICATIONS_STORE=prisma
PAYMENTS_STORE=prisma
AUTH_STORE=prisma
# Job applications ATS store. If unset, follow JOBS_STORE.
APPLICATIONS_STORE=prisma
# Seeker profile / saved jobs / hidden / saved searches. If unset, follow JOBS_STORE.
SEEKER_STORE=prisma
# Performance Score (seeker + employer). If unset, follow JOBS_STORE.
REPUTATION_STORE=prisma
# Feedback FAQ + Contact Admin messenger. If unset, follow JOBS_STORE.
FEEDBACK_STORE=prisma
# NOTIFICATIONS_STORE=memory
# PAYMENTS_STORE=memory
# AUTH_STORE=memory
# APPLICATIONS_STORE=memory
# SEEKER_STORE=memory
# REPUTATION_STORE=memory
# FEEDBACK_STORE=memory
# App DDL lives in schema `xcron` (not public). Apply with: npm run prisma:migrate
DATABASE_URL=postgresql://xcron:xcron@localhost:5433/xcron?schema=xcron
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:8100,https://localhost,capacitor://localhost
# Unlock price + auth TTLs: Prisma SiteConfig via web Settings (/settings). Not env.
# Identities that receive admin role after OTP / Google verify
ADMIN_IDENTITIES=superadmin@xcron.app,admin@xcron.local
# Required for password-based super-admin login (POST /v1/auth/admin/login)
SUPER_ADMIN_EMAIL=superadmin@xcron.app
SUPER_ADMIN_PASSWORD=change-me-to-a-long-random-secret
# Access token TTL minutes (cookie / Bearer). Refresh TTL = SiteConfig sessionTtlDays.
# AUTH_ACCESS_TTL_MINUTES=15
# Cookie session (HttpOnly access + refresh + CSRF twin). Prod cross-origin needs None+Secure.
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=0
# AUTH_SINGLE_TAB=1
# AUTH_SINGLE_SESSION=1
# Rate limits (Nest throttler). Sensitive = 1 req / hour for admin login, account wipe, payment confirm, notification dev.
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=120
# RATE_LIMIT_AUTH_TTL_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_SENSITIVE_TTL_MS=3600000
# RATE_LIMIT_SENSITIVE_MAX=1
# Job apply anti-spam: burst throttle + per-seeker UTC daily/hourly caps + cooldown.
# APPLY_RATE_LIMIT_TTL_MS=60000
# APPLY_RATE_LIMIT_MAX=5
# APPLY_DAILY_CAP=20
# APPLY_HOURLY_CAP=8
# APPLY_COOLDOWN_MS=30000
# Identical cover-note reuse (normalized). Empty notes skip this check.
# APPLY_IDENTICAL_NOTE_MAX=2
# APPLY_IDENTICAL_NOTE_WINDOW_MS=86400000
# Soft velocity badge for employers (below hard hourly/daily caps; does not block).
# APPLY_VELOCITY_FLAG_HOURLY=5
# APPLY_VELOCITY_FLAG_DAILY=12
# APPLY_PROFILES_STORE=prisma|memory (falls back to APPLICATIONS_STORE → JOBS_STORE)
# SEEKER_STORE=prisma|memory (falls back to JOBS_STORE) — profile + saved jobs + hidden + searches

# Google Identity (Web client ID; comma-separated list also OK via GOOGLE_CLIENT_IDS)
# GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...   # kept server-side only; not required for GIS idToken verify
# AUTH_GOOGLE_STUB=1
# Set ENABLE_SWAGGER=1 to expose /docs in production
# ENABLE_SWAGGER=0
# Free local OCR (default). Use stub to skip Tesseract.
OCR_PROVIDER=tesseract
# OCR_LANGS=eng
# OCR_LANGS=eng+tam
# OCR_DEBUG=1
# OCR_MONTHLY_PAGE_CAP=5000
# Optional AI job-text enrich + multi-job digest split (Telegram jobfare packs many
# recruitments in one message → separate import rows via splitJobs).
# Off by default. Free path: Groq free tier, or local Ollama. Never invents contacts.
# When off, dash/blank-line heuristic still splits multi-job pastes.
AI_ENRICH_ENABLED=0
# AI_ENRICH_PROVIDER=stub
# AI_ENRICH_PROVIDER=groq
# AI_ENRICH_API_KEY=
# AI_ENRICH_MODEL=openai/gpt-oss-20b
# AI_ENRICH_PROVIDER=ollama
# AI_ENRICH_BASE_URL=http://127.0.0.1:11434/v1
# AI_ENRICH_MODEL=llama3.2
# AI_ENRICH_TIMEOUT_MS=45000
# AI_ENRICH_MONTHLY_CAP=2000
# job-enrich accepts optional `instruction` for chat-style moderator corrections;
# returns contactWebsite + guessed contentLanguage for form boxes.
#
# In-app floating help chatbot (signed-in only). Free/low model; heavy rate limits.
# Falls back to AI_ENRICH_API_KEY / provider when AI_HELP_* unset.
AI_HELP_ENABLED=0
# AI_HELP_PROVIDER=stub
# AI_HELP_PROVIDER=groq
# AI_HELP_API_KEY=
# AI_HELP_MODEL=openai/gpt-oss-20b
# AI_HELP_PROVIDER=ollama
# AI_HELP_BASE_URL=http://127.0.0.1:11434/v1
# AI_HELP_MODEL=llama3.2:1b
# AI_HELP_TIMEOUT_MS=20000
# AI_HELP_MAX_COMPLETION_TOKENS=220
# AI_HELP_MAX_MESSAGE_CHARS=400
# AI_HELP_MAX_HISTORY_TURNS=4
# AI_HELP_DAILY_TOKEN_BUDGET=2500
# AI_HELP_COOLDOWN_MS=20000
# AI_HELP_EXHAUST_COOLDOWN_MS=21600000
# AI_HELP_RATE_LIMIT_MAX=3
# AI_HELP_RATE_LIMIT_TTL_MS=60000

# Free India LGD location catalog (states/districts/search). Override only if mirroring.
# LGD_API_BASE=https://india-lgd-index-api.vercel.app
# Notifications (Strategy/Adapter — see api/src/notifications/CLAUDE.md). Free-first:
# Push: stub (log-only) → fcm (firebase-admin). Mail: stub/console → smtp later.
PUSH_PROVIDER=stub
MAIL_PROVIDER=stub
# NOTIFICATION_MODE=stub
# NOTIFICATION_FANOUT_BATCH=25
# Welcome + profile-complete on first login; day 1–N auto nudges while seeker profile incomplete.
# PROFILE_REMINDER_SCHEDULE_ENABLED=1
# PROFILE_REMINDER_MAX_DAYS=2
# PROFILE_REMINDER_TICK_MS=3600000
# MAIL_SMTP_URL=
# Live FCM (₹0) — closed-app Android tray. See docs/FCM_SETUP.md
# 1) mobile/android/app/google-services.json (Firebase Android app com.xcron.jobs)
# 2) api/secrets/firebase-service-account.json (Firebase service account key)
# 3) node scripts/setup-fcm.mjs
# PUSH_PROVIDER=fcm
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# On Render use JSON (one line) — PATH must be a file path, never the JSON body:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FCM_ANDROID_CHANNEL_ID=xcron-job-alerts-v2


# Payments (Strategy/Adapter — see .cursor/skills/xcron-payments). Free-first:
# stub (local) → upi (merchant VPA QR/ID, ₹0 PSP) → razorpay/cashfree/phonepe later.
PAYMENT_GATEWAY=stub
# PAYMENT_MODE=stub
# PAYMENT_GATEWAY=upi
# PAYMENT_UPI_VPA=yourname@oksbi
# PAYMENT_UPI_PAYEE_NAME=X Cron
# PAYMENT_UPI_ALLOW_DEV_CONFIRM=1
# PAYMENT_ALLOW_CLIENT_CONFIRM=1
# Client confirm is always blocked when NODE_ENV=production
# PAYMENT_GATEWAY=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_WEBHOOK_SECRET=dev_secret
# Commerce toggles (paymentsEnabled / postJobPaymentMode) live in Settings UI → SiteConfig commerce

# Job Fare channel pull (free). Telegram Bot API optional; WhatsApp = manual paste bridge only.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_MODE=poll
# TELEGRAM_WEBHOOK_SECRET=
# CHANNEL_SCHEDULE_ENABLED=1
# CHANNEL_PULL_OWNER_USER_ID=

