PORT=3000
NODE_ENV=development
# Step 1 uses in-memory jobs store by default.
JOBS_STORE=memory
# When ready for PostgreSQL (docker compose up -d):
# JOBS_STORE=prisma
# App DDL lives in schema `xcron` (not public). Apply with: npm run prisma:migrate
# DATABASE_URL=postgresql://xcron:xcron@localhost:5432/xcron?schema=xcron
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:8100
UNLOCK_PRICE_PAISE=500
# Identities that receive admin role after OTP / Google verify
ADMIN_IDENTITIES=superadmin@xcron.app,admin@xcron.local
# Required for password-based super-admin login (POST /v1/auth/admin/login)
SUPER_ADMIN_EMAIL=superadmin@xcron.app
SUPER_ADMIN_PASSWORD=change-me-to-a-long-random-secret
# Google Identity (Web client ID; comma-separated list also OK via GOOGLE_CLIENT_IDS)
# GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...   # kept server-side only; not required for GIS idToken verify
# AUTH_GOOGLE_STUB=1
# Set ENABLE_SWAGGER=1 to expose /docs in production
# ENABLE_SWAGGER=0
# Free local OCR (default). Use stub to skip Tesseract.
OCR_PROVIDER=tesseract
# OCR_LANGS=eng
# OCR_LANGS=eng+tam
# OCR_DEBUG=1
# OCR_MONTHLY_PAGE_CAP=5000
# Free India LGD location catalog (states/districts/search). Override only if mirroring.
# LGD_API_BASE=https://india-lgd-index-api.vercel.app

